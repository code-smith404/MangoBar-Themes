// Ember Glass — MangoBar V2.0
{
    "layer": "top",
    "height": 38,
    "buffer-scale": 1,
    "sys-interval": 2,
    "scroll-interval": 100,

    // Left: workspaces and current window. Center: date and time. Right: system status.
    "modules-left": [
        "workspaces",
        "layout",
        "window"
    ],
    "modules-center": [
        "clock#date",
        "clock#time"
    ],
    "modules-right": [
        "tray",
        "network",
        "pulseaudio",
        "cpu",
        "memory",
        "battery",
        "custom/power"
    ],

    "workspaces": {
        "hide-empty": true,
        "pinned": [1, 2, 3, 4, 5],
        "on-click": "activate",
        "on-click-right": "toggle",
        "on-scroll-up": "mmsg dispatch viewtoleft_have_client",
        "on-scroll-down": "mmsg dispatch viewtoright_have_client"
    },
    "layout": {
        "format": "{}"
    },
    "window": {
        "format": "{}",
        "max-length": 42
    },
    "tray": {
        "icon-size": 16,
        "spacing": 6
    },
    "network": {
        "format": "{icon} {ifname}",
        "format-wifi": "{icon} {signal} {ssid}",
        "format-ethernet": "{icon} {ifname}",
        "format-disconnected": "{icon} offline",
        "format-alt": "↓ {down}  ↑ {up}",
        "icon-wifi": "󰖩",
        "icon-ethernet": "󰈀",
        "icon-disconnected": "󰖪",
        "signal-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "max-length": 24
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "icons": ["󰝟", "󰕿", "󰕾"],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "cpu": {
        "format": "󰍛 {usage}%"
    },
    "memory": {
        "format": "󰘚 {}%"
    },
    "battery": {
        "format": "{icon} {percent}%",
        "icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "clock#date": {
        "format": " {:L%a, %d %b}"
    },
    "clock#time": {
        "format": " {:L%H:%M}"
    },
    "custom/power": {
        "exec": "printf '⏻'",
        "format": "{}",
        "on-click": "$HOME/.config/mangobar/scripts/power-menu.sh"
    }
}
