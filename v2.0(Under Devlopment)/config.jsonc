{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 4,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "modules-left": ["workspaces", "custom/visualizer"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "disk", "network", "pulseaudio", "battery"],

    "workspaces": {
        "all-outputs": true,
        "format": "{name}",
        "persistent-workspaces": {"*": [1, 2, 3, 4]},
        "on-click": "mmsg tag {index}",
        "on-click-right": "mmsg move {index}"
    },
    "custom/visualizer": {
        "exec": "$HOME/.config/mangobar/scripts/cava-visualizer.sh",
        "format": "{}",
        "restart-interval": 2,
        "tooltip": false
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%A, %B %d}</big>\n<tt>{calendar}</tt>"
    },
    "cpu": {
        "interval": 2,
        "format": " {usage}%"
    },
    "memory": {
        "interval": 5,
        "format": "󰍛 {percentage_used}%"
    },
    "disk": {
        "interval": 30,
        "path": "/",
        "format": "󰋊 {percentage_used}%",
        "tooltip-format": "{path}: {used} / {total} used"
    },
    "network": {
        "interval": 3,
        "format": "󰈀 {ifname}",
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "󰖪 offline",
        "format-alt": "↓{bandwidthDownBytes} ↑{bandwidthUpBytes}",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-disconnected": "Network disconnected"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": ["", "", ""],
        "tooltip": true,
        "on-click": "$HOME/.config/mangobar/scripts/volume.sh mute",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "$HOME/.config/mangobar/scripts/volume.sh up",
        "on-scroll-down": "$HOME/.config/mangobar/scripts/volume.sh down"
    },
    "battery": {
        "interval": 30,
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "states": {
            "warning": 30,
            "critical": 15
        }
    }
}
