// macOS Dark — a minimal dark menu bar for MangoBar, without an Apple logo.
{
    "layer": "top",
    "height": 28,
    "buffer-scale": 1,
    "sys-interval": 2,
    "scroll-interval": 100,

    // Workspaces and files on the left; active window centered; status on the right.
    "modules-left": [
        "workspaces",
        "custom/files-menu"
    ],
    "modules-center": [
        "window"
    ],
    "modules-right": [
        "tray",
        "network",
        "pulseaudio",
        "battery",
        "clock#date",
        "clock#time"
    ],

    "workspaces": {
        "hide-empty": true,
        "pinned": [1, 2, 3, 4, 5],
        "on-click": "activate",
        "on-click-right": "toggle",
        "on-scroll-up": "mmsg dispatch viewtoleft_have_client",
        "on-scroll-down": "mmsg dispatch viewtoright_have_client"
    },
    "custom/files-menu": {
        "exec": "printf 'Files'",
        "format": "{}",
        "on-click": "$HOME/.config/mangobar/scripts/menu.sh files"
    },
    "window": {
        "format": "{}",
        "max-length": 38
    },
    "tray": {
        "icon-size": 14,
        "spacing": 4
    },
    "network": {
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "{icon}",
        "format-disconnected": "{icon}",
        "format-alt": "↓ {down}  ↑ {up}",
        "icon-wifi": "◉",
        "icon-ethernet": "◆",
        "icon-disconnected": "○",
        "max-length": 24
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "icons": ["󰝟", "󰕿", "󰕾"],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "battery": {
        "format": "{icon} {percent}%",
        "icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "clock#date": {
        "format": "{:L%a %b %d}"
    },
    "clock#time": {
        "format": "{:%H:%M}"
    }
}
