// Lumen — a dark, macOS-inspired MangoBar menu bar (without an Apple logo).
{
    "layer": "top",
    "height": 34,
    "buffer-scale": 1,
    "sys-interval": 2,
    "scroll-interval": 100,

    // Menu-style actions on the left; compact system status and clock on the right.
    "modules-left": [
        "custom/workspace-menu",
        "custom/apps-menu",
        "custom/files-menu",
        "custom/help-menu",
        "window"
    ],
    "modules-center": [],
    "modules-right": [
        "tray",
        "network",
        "pulseaudio",
        "battery",
        "clock#date",
        "clock#time",
        "custom/power"
    ],

    "custom/workspace-menu": {
        "exec": "printf 'Workspace'",
        "format": "{}",
        "on-click": "$HOME/.config/mangobar/scripts/menu.sh workspace"
    },
    "custom/apps-menu": {
        "exec": "printf 'Apps'",
        "format": "{}",
        "on-click": "$HOME/.config/mangobar/scripts/menu.sh apps"
    },
    "custom/files-menu": {
        "exec": "printf 'Files'",
        "format": "{}",
        "on-click": "$HOME/.config/mangobar/scripts/menu.sh files"
    },
    "custom/help-menu": {
        "exec": "printf 'Help'",
        "format": "{}",
        "on-click": "$HOME/.config/mangobar/scripts/menu.sh help"
    },
    "window": {
        "format": "{}",
        "max-length": 34
    },
    "tray": {
        "icon-size": 15,
        "spacing": 5
    },
    "network": {
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "{icon}",
        "format-disconnected": "{icon}",
        "format-alt": "↓ {down}  ↑ {up}",
        "icon-wifi": "◉",
        "icon-ethernet": "◆",
        "icon-disconnected": "○",
        "max-length": 24
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "icons": ["󰝟", "󰕿", "󰕾"],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "battery": {
        "format": "{icon} {percent}%",
        "icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "clock#date": {
        "format": "{:L%a %b %d}"
    },
    "clock#time": {
        "format": "{:%H:%M}"
    },
    "custom/power": {
        "exec": "printf '⏻'",
        "format": "{}",
        "on-click": "$HOME/.config/mangobar/scripts/power-menu.sh"
    }
}
