{
    "layer": "top",
    "height": 34,
    "buffer-scale": 1,
    "sys-interval": 2,
    "scroll-interval": 100,
    "modules-left": [
        "workspaces",
        "window"
    ],
    "modules-center": [
        "clock#date",
        "clock#time"
    ],
    "modules-right": [
        "network",
        "pulseaudio",
        "cpu",
        "memory",
        "battery",
        "custom/power"
    ],
    "workspaces": {
        "hide-empty": true,
        "pinned": [1, 2, 3, 4, 5],
        "on-click": "activate",
        "on-click-right": "toggle",
        "on-scroll-up": "mmsg dispatch viewtoleft_have_client",
        "on-scroll-down": "mmsg dispatch viewtoright_have_client"
    },
    "window": {
        "format": "{}",
        "max-length": 240
    },
    "clock#date": {
        "format": "{:L%a, %d %b}"
    },
    "clock#time": {
        "format": "{:%H:%M}"
    },
    "network": {
        "format": "◉ {ifname}",
        "format-wifi": "◉ {ssid}",
        "format-ethernet": "◆ {ifname}",
        "format-disconnected": "◉ offline",
        "format-alt": "↓ {down}  ↑ {up}",
        "max-length": 120
    },
    "pulseaudio": {
        "format": "♫ {volume}%",
        "format-muted": "♫ muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "cpu": {
        "format": "CPU {usage}%"
    },
    "memory": {
        "format": "RAM {}%"
    },
    "battery": {
        "format": "BAT {percent}%"
    },
    "custom/power": {
        "exec": "printf '⏻'",
        "format": "{}",
        "on-click": "$HOME/.config/mangobar/scripts/power-menu.sh"
    }
}
