// Square — an interactive MangoBar layout with square corners throughout.
{
    "layer": "top",
    "height": 34,
    "buffer-scale": 1,
    "sys-interval": 2,
    "scroll-interval": 100,
    "font": "JetBrainsMono Nerd Font",

    "modules-left": [
        "workspaces"
    ],
    "modules-center": [
        "window"
    ],
    "modules-right": [
        "network",
        "custom/notifications",
        "clock#date",
        "cpu",
        "memory",
        "pulseaudio",
        "custom/power"
    ],

    "workspaces": {
        "hide-empty": true,
        "pinned": [1, 2, 3, 4, 5],
        "on-click": "activate",
        "on-click-right": "toggle",
        "on-scroll-up": "mmsg dispatch viewtoleft_have_client",
        "on-scroll-down": "mmsg dispatch viewtoright_have_client"
    },
    "window": {
        "format": "{}",
        "max-length": 48
    },
    "network": {
        "format": "{icon}",
        "format-wifi": "{signal}",
        "format-ethernet": "{icon}",
        "format-disconnected": "{icon}",
        "icon-wifi": "󰖩",
        "icon-ethernet": "󰈀",
        "icon-disconnected": "󰖪",
        "signal-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "on-click": "$HOME/.config/mangobar/scripts/controls.sh network"
    },
    "custom/notifications": {
        "format": "󰂚",
        "on-click": "$HOME/.config/mangobar/scripts/controls.sh notifications"
    },
    "clock#date": {
        "format": " {:L%a %d %b}",
        "on-click": "$HOME/.config/mangobar/scripts/controls.sh calendar"
    },
    "cpu": {
        "format": " {load}%",
        "on-click": "$HOME/.config/mangobar/scripts/controls.sh system-monitor"
    },
    "memory": {
        "format": "󰍛 {}%",
        "on-click": "$HOME/.config/mangobar/scripts/controls.sh system-monitor"
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "icons": ["󰝟", "󰕿", "󰕾"],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "$HOME/.config/mangobar/scripts/power-menu.sh"
    }
}
